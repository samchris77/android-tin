    "profile.about.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TinnitusTracker is designed to help you manage tinnitus symptoms through personalized frequency matching, progress tracking, and evidence-based techniques."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TinnitusTracker는 개인화된 주파수 매칭, 진행 상황 추적 및 증거 기반 기법을 통해 이명 증상을 관리할 수 있도록 설계되었습니다."
          }
        }
      }
    },
    "profile.about.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember: This app is not a substitute for professional medical advice. Please consult with a healthcare provider for proper diagnosis and treatment."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주의: 이 앱은 전문의료진의 조언을 대체할 수 없습니다. 정확한 진단과 치료를 위해서는 의료진과 상담하시기 바랍니다."
          }
        }
      }
    },
